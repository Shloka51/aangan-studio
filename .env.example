# ---- Brain (Gemini) ----------------------------------------------------
# Without a key, the core falls back to the deterministic rule-based brain.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Price per 1M tokens in USD, used for the ₹ cost estimate. Check current Gemini pricing.
GEMINI_USD_PER_M_INPUT=0.30
GEMINI_USD_PER_M_OUTPUT=2.50
USD_TO_INR=88

# ---- Store (Supabase) ----------------------------------------------------
# Without these, an in-memory store is used (harness/tests only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Handoff ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_STUDIO_HEAD_CHAT_ID=
RESEND_API_KEY=
HANDOFF_EMAIL_FROM=Aangan Enquiries <onboarding@resend.dev>
HANDOFF_EMAIL_TO=
STUDIO_HEAD_EMAIL=

# ---- Booking (Cal.com) -----------------------------------------------------
# Public booking page, e.g. https://cal.com/aangan-studio/consultation
CALCOM_BOOKING_URL=

# ---- Voice (Vaani, vaanivoice.ai) ---------------------------------------------
# Call server (server/vaani-ws.ts): paste the same value into Vaani → Agent → Brain →
# Bring your Own LLM → Auth Token. Vaani sends it as "Authorization: Bearer <token>".
VAANI_BYOL_TOKEN=
# Call-event webhook on Vercel: register https://<app>/api/voice/vaani?token=<this value>
# in Vaani → Settings → Webhooks (Vaani's webhooks are not signed, so the URL carries it).
VAANI_WEBHOOK_SECRET=
# Port for the call server (hosts usually set this).
PORT=8787

# ---- Dashboard ---------------------------------------------------------------
DASHBOARD_PASSWORD=
# Set to 1 to make the dashboard public (demo / review). Leave unset to require the password.
DASHBOARD_PUBLIC=
